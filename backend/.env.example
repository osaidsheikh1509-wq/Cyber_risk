# Cyber Risk Tracker Backend Environment Configuration Example
# Copy this file to .env and configure secrets accordingly.

APP_NAME="Cyber Risk Tracker API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./cyber_risk.db"

# Security Secrets (Never commit actual secrets to version control)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Sarvam AI & Risk Assessment Configuration
SARVAM_API_KEY=""
MODEL_BACKEND="mock" # Options: mock, sarvam, ollama

# Ollama Model Backend Configuration
MODEL_URL="http://localhost:11434"
MODEL_NAME="cyber-risk"

# Database Backend Selection (sqlite | mongo)
DB_BACKEND="sqlite"
DB_FALLBACK=true
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="cyber_risk_tracker"

